{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    ':timezone(Europe/Paris)',
    'config:recommended',
    'docker:enableMajor',
    'helpers:pinGitHubActionDigests',
    ':disableRateLimiting',
    ':dependencyDashboard',
    ':semanticCommits',
    ':enablePreCommit',
    ':automergeBranch',
    'github>spike442/homelab//.renovate/autoMerge.json5',
    'github>spike442/homelab//.renovate/labels.json5',
    'github>spike442/homelab//.renovate/semanticCommits.json5',
    'github>spike442/homelab//.renovate/packageGroups.json5',
  ],
  rebaseWhen: 'behind-base-branch',
  minimumReleaseAge: '3 days',
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 3am on the first day of the month'],
    commitMessageExtra: '({{manager}})',
    additionalBranchPrefix: '{{manager}}-',
  },
  ignorePaths: [
    '**/.history/**',
  ],
  flux: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml$/',
    ],
  },
  'docker-compose': {
    managerFilePatterns: [
      '/(^|/)ansible/.+compose\\.ya?ml$/',
    ],
  },
  'ansible-galaxy': {
    managerFilePatterns: [
      '/(^|/)ansible/requirements\\.ya?ml$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      description: 'Ansible git collections with GitHub URLs',
      managerFilePatterns: [
        '/(^|/)ansible/requirements\\.ya?ml$/',
      ],
      matchStrings: [
        '- name: https://github\\.com/(?<depName>[^\\s]+?)\\s*\\n\\s*type: git\\s*\\n\\s*version: (?<currentValue>[^\\s]+)',
      ],
      datasourceTemplate: 'github-tags',
    },
    {
      customType: 'regex',
      description: 'Kubernetes values annotated with a renovate comment',
      managerFilePatterns: [
        '/(^|/)kubernetes/.+\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+?[:=/]\\s*"?(?<currentValue>v?\\d+(?:\\.\\d+)*[^\\s"@/]*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?',
      ],
      datasourceTemplate: '{{{datasource}}}',
    },
    {
      customType: 'regex',
      description: 'GitHub raw URLs pinned to a release tag',
      managerFilePatterns: [
        '/(^|/)kubernetes/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'https://raw\\.githubusercontent\\.com/(?<depName>[\\w.-]+/[\\w.-]+)/refs/tags/(?<currentValue>[^/\\s]+)/',
      ],
      datasourceTemplate: 'github-tags',
    },
    {
      customType: 'regex',
      description: 'Airflow DAGs git-synced from a Stonks release tag',
      managerFilePatterns: [
        '/(^|/)kubernetes/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'repo: https://github\\.com/(?<depName>spike442/shed)\\.git\\n\\s+ref: stonks-(?<currentValue>\\d+\\.\\d+\\.\\d+)',
      ],
      datasourceTemplate: 'github-tags',
      extractVersionTemplate: '^stonks-(?<version>\\d+\\.\\d+\\.\\d+)$',
    },
    {
      customType: 'regex',
      description: 'GitHub raw URLs pinned to a main branch commit',
      managerFilePatterns: [
        '/(^|/)kubernetes/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'https://raw\\.githubusercontent\\.com/(?<depName>[\\w.-]+/[\\w.-]+)/(?<currentDigest>[0-9a-f]{40})/',
      ],
      datasourceTemplate: 'git-refs',
      packageNameTemplate: 'https://github.com/{{{depName}}}',
      currentValueTemplate: 'main',
    },
  ],
  packageRules: [
    {
      description: 'Kafka versions wait for dashboard approval until Strimzi supports them',
      matchPackageNames: [
        'apache/kafka',
      ],
      dependencyDashboardApproval: true,
      automerge: false,
    },
    {
      description: 'Disable ansible-galaxy manager for git-type collections',
      matchManagers: [
        'ansible-galaxy',
      ],
      matchPackageNames: [
        'https://github.com/k3s-io/k3s-ansible',
      ],
      enabled: false,
    },
  ],
}
