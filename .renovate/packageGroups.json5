{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Sentinel release group: the sentinel and stonks charts, their images, and the Airflow Stonks version deploy together as soon as Sentinel Publish releases them",
      groupName: "sentinel",
      matchPackageNames: [
        "/^ghcr\\.io\\/spike442\\/sentinel/",
        "/^ghcr\\.io\\/spike442\\/stonks/",
        "/spike442\\/charts\\/sentinel$/",
        "/spike442\\/charts\\/stonks$/",
      ],
      minimumReleaseAge: "0 days",
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
      group: {
        commitMessageTopic: "{{{groupName}}} release",
      },
    },
    {
      description: "Envoy Gateway Group",
      groupName: "envoy-gateway",
      matchPackageNames: ["/envoyproxy\\/gateway/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Recyclarr Group",
      groupName: "recyclarr",
      matchPackageNames: ["/recyclarr\\/recyclarr/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "1Password Connect Group",
      groupName: "1password-connect",
      matchDatasources: ["docker"],
      matchPackageNames: ["/1password/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchPackageNames: ["/flux-operator/", "/flux-instance/", "/flux-operator-manifests/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 3,
    },
    {
      description: "Kubernetes Group",
      groupName: "kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 5,
    },
    {
      description: "Ansible Collections Group",
      groupName: "ansible-collections",
      matchManagers: ["ansible-galaxy"],
      matchDatasources: ["galaxy-collection", "git-tags"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },

  ],
}
