{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Shed release group: whichever of the shed, sentinel, and stonks charts Shed Publish released, their images, and for Stonks the Airflow Stonks version and the stonks release tag Airflow git-syncs its DAGs from, deploy together as soon as Publish releases them",
      groupName: "shed",
      matchPackageNames: [
        "spike442/shed",
        "/^ghcr\\.io\\/spike442\\/shed\\//",
        "/spike442\\/charts\\/shed\\/(shed|sentinel|stonks)$/",
      ],
      minimumReleaseAge: "0 days",
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
      group: {
        commitMessageTopic: "{{{groupName}}} release",
      },
    },
    {
      description: "Envoy Gateway Group",
      groupName: "envoy-gateway",
      matchPackageNames: ["/envoyproxy\\/gateway/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Recyclarr Group",
      groupName: "recyclarr",
      matchPackageNames: ["/recyclarr\\/recyclarr/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "1Password Connect Group",
      groupName: "1password-connect",
      matchDatasources: ["docker"],
      matchPackageNames: ["/1password/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchPackageNames: ["/flux-operator/", "/flux-instance/", "/flux-operator-manifests/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 3,
    },
    {
      description: "Ansible Collections Group",
      groupName: "ansible-collections",
      matchManagers: ["ansible-galaxy"],
      matchDatasources: ["galaxy-collection", "git-tags"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },

  ],
}
