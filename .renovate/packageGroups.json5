{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "SRE release group: the sre chart and images SRE Publish released deploys as soon as it is published",
      groupName: "sre",
      matchPackageNames: [
        "/^ghcr\\.io\\/spike442\\/sre\\//",
        "/spike442\\/charts\\/sre\\/sre$/",
      ],
      minimumReleaseAge: "0 days",
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
      group: {
        commitMessageTopic: "{{{groupName}}} release",
      },
    },
    {
      description: "Knowledge release group: the knowledge chart Knowledge Publish released deploys as soon as it is published",
      groupName: "knowledge",
      matchPackageNames: [
        "/^ghcr\\.io\\/spike442\\/knowledge\\//",
        "/spike442\\/charts\\/knowledge\\/knowledge$/",
      ],
      minimumReleaseAge: "0 days",
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
      group: {
        commitMessageTopic: "{{{groupName}}} release",
      },
    },
    {
      description: "Stonks release group: the stonks chart, the Airflow Stonks version, and the release tag Airflow git-syncs the DAGs from deploy together as soon as Stonks Publish releases them",
      groupName: "stonks",
      matchPackageNames: [
        "spike442/stonks",
        "/^ghcr\\.io\\/spike442\\/stonks\\//",
        "/spike442\\/charts\\/stonks\\/stonks$/",
      ],
      minimumReleaseAge: "0 days",
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
      group: {
        commitMessageTopic: "{{{groupName}}} release",
      },
    },
    {
      description: "Envoy Gateway Group",
      groupName: "envoy-gateway",
      matchPackageNames: ["/envoyproxy\\/gateway/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Recyclarr Group",
      groupName: "recyclarr",
      matchPackageNames: ["/recyclarr\\/recyclarr/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "1Password Connect Group",
      groupName: "1password-connect",
      matchDatasources: ["docker"],
      matchPackageNames: ["/1password/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchPackageNames: ["/flux-operator/", "/flux-instance/", "/flux-operator-manifests/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 3,
    },
    {
      description: "Ansible Collections Group",
      groupName: "ansible-collections",
      matchManagers: ["ansible-galaxy"],
      matchDatasources: ["galaxy-collection", "git-tags"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },

  ],
}
